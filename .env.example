# Copy this file to .env and fill in values before running docker compose.
# .env is gitignored — never commit secrets.

# PostgreSQL
POSTGRES_PASSWORD=devpassword

# Backend
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-a-random-32-char-string

# Single-admin login (stand-in until Keycloak is active). Generate the hash
# with: cd backend && python scripts/hash_password.py <your-password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Qualitative indicators (evaluation grid). All optional.
# NCBI_API_KEY raises the PubMed E-utilities rate limit (3 -> 10 req/s).
NCBI_API_KEY=
# Small LLM served by vLLM (OpenAI-compatible endpoint), used for the peer-review
# criterion of journals absent from DOAJ. Leave VLLM_BASE_URL empty to disable.
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=

# NOTE: The OpenAlex API key is NOT stored here.
# It is entered via the /setup wizard in the UI and stored in the database.
# Storing it in .env would expose it via version control; the DB is the right place.